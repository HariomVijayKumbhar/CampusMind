# Backend Environment Variables

# Server
PORT=5000

# Frontend URL for CORS (set to deployed Vercel URL in production)
FRONTEND_URL=http://localhost:3000

# Supabase (use SERVICE ROLE KEY server-side only - never expose to frontend)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Groq (default model: qwen/qwen3.8-27b - llama-3.3-70b-versatile returns 404)
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the default model
# GROQ_MODEL=qwen/qwen3.8-27b

# Optional: Node environment
NODE_ENV=development
