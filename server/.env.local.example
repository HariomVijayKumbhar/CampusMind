# Backend Environment Variables

# Server
PORT=5000

# Frontend URL for CORS (set to deployed Vercel URL in production)
FRONTEND_URL=http://localhost:3000

# Supabase (use SERVICE ROLE KEY server-side only - never expose to frontend)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# AI Provider Configuration (openrouter or groq)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/auto

# Groq API for LLM (fallback or alternate)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional: Node environment
NODE_ENV=development
